{
 "charts": [],
 "content": "[{\"id\": \"hdr\", \"type\": \"header\", \"data\": {\"text\": \"<span class='h4'>AlphaX Infra \\u2014 discovery and control assessment</span>\", \"col\": 12}}, {\"id\": \"para\", \"type\": \"paragraph\", \"data\": {\"text\": \"Agentless discovery against Microsoft Entra ID, Intune and Azure. Observations feed the same control library, evidence model and client register as AlphaX GRC, so a machine-collected fact and a consultant's screenshot land in one place.<br><br><b>Order of work:</b> record consent \\u2192 configure and enable a connector \\u2192 run discovery \\u2192 review merge proposals \\u2192 evaluate checks \\u2192 review findings. Nothing collects before a consent record is Active.\", \"col\": 12}}, {\"id\": \"sc1\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Consent\", \"col\": 3}}, {\"id\": \"sc2\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Connectors\", \"col\": 3}}, {\"id\": \"sc3\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Assets\", \"col\": 3}}, {\"id\": \"sc4\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Failing checks\", \"col\": 3}}, {\"id\": \"sp\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"cards\", \"type\": \"card\", \"data\": {\"card_name\": \"Start here\", \"col\": 4}}, {\"id\": \"cards2\", \"type\": \"card\", \"data\": {\"card_name\": \"Discovery\", \"col\": 4}}, {\"id\": \"cards3\", \"type\": \"card\", \"data\": {\"card_name\": \"Estate\", \"col\": 4}}, {\"id\": \"cards4\", \"type\": \"card\", \"data\": {\"card_name\": \"Assessment\", \"col\": 4}}, {\"id\": \"cards5\", \"type\": \"card\", \"data\": {\"card_name\": \"Configuration\", \"col\": 4}}]",
